#!/bin/sh
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
APP_ID=org.webosbrew.chromium120

export TMPDIR=/tmp
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export DISPLAY_ID=${DISPLAY_ID:-0}
export APP_ID
export BROWSER_APP_ID=$APP_ID
export LD_LIBRARY_PATH="$APP_DIR/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# SAM exposes the application directory as HOME inside its jail.  That tree
# is not writable by the runtime uid, so keep Chromium's mutable profile in
# the writable tmpfs instead.
# webOS may export XDG_CACHE_HOME to the read-only application tree.  Keep
# the mutable browser profile on tmpfs regardless of the inherited HOME/XDG
# values.
CACHE_ROOT=/tmp/.cache
export XDG_CACHE_HOME="$CACHE_ROOT"
DATA_DIR="$CACHE_ROOT/chromium120"
mkdir -p "$XDG_RUNTIME_DIR" "$DATA_DIR" "$APP_DIR/extensions"

# libcbe exports the webOS BrowserBase data symbols consumed by the shell.
# Preload it only for Chromium, not for the setup commands above.
export LD_PRELOAD="$APP_DIR/bin/libcbe.so${LD_PRELOAD:+:$LD_PRELOAD}"

exec "$APP_DIR/bin/browser_shell" \
  --no-sandbox \
  --no-zygote \
  --disable-gpu-watchdog \
  --gpu-no-context-lost \
  --ignore-gpu-blocklist \
  --in-process-gpu \
  --disable-component-update \
  --disable-translate \
  --enable-accelerated-compositing \
  --enable-smooth-scrolling \
  --start-maximized \
  --user-data-dir="$DATA_DIR" \
  --shell-app-id="$APP_ID" \
  --shell-app-path="file://$APP_DIR/index.html" \
  --shell-fullscreen=true \
  --shell-web-apis=v8/browser_shell,v8/browser_shell_ipc \
  --ozone-platform=wayland_external \
  --allow-load-extensions-in=persist:webcontent,private \
  --load-extension="$APP_DIR/extensions" \
  "$@" >>"/tmp/$APP_ID.log" 2>&1
