#!/bin/sh
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
APP_ID=org.webosbrew.chromium120

export TMPDIR=/tmp
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export DISPLAY_ID=${DISPLAY_ID:-0}
export APP_ID
export BROWSER_APP_ID=$APP_ID
export LD_LIBRARY_PATH="$APP_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

CACHE_ROOT=${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}
DATA_DIR="$CACHE_ROOT/chromium120"
mkdir -p "$XDG_RUNTIME_DIR" "$DATA_DIR" "$APP_DIR/extensions"

exec "$APP_DIR/bin/browser_shell" \
  --no-sandbox \
  --no-zygote \
  --disable-gpu-watchdog \
  --gpu-no-context-lost \
  --ignore-gpu-blocklist \
  --in-process-gpu \
  --disable-component-update \
  --disable-translate \
  --enable-accelerated-compositing \
  --enable-smooth-scrolling \
  --start-maximized \
  --user-data-dir="$DATA_DIR" \
  --shell-app-id="$APP_ID" \
  --shell-app-path="file://$APP_DIR/index.html" \
  --shell-fullscreen=true \
  --shell-web-apis=v8/browser_shell,v8/browser_shell_ipc \
  --ozone-platform=wayland \
  --allow-load-extensions-in=persist:webcontent,private \
  --load-extension="$APP_DIR/extensions" \
  "$@"
